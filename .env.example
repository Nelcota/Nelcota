# Environment-file sample for Compose/systemd or explicit process setup.
# nelcota serve does not load .env automatically: use process variables or TOML.
# nelcota dev generates its own settings in .nelcota/dev.env.
# See docs/configuration.md for all fields, defaults, scopes and validation.
# Replace example secrets; generate passwords with: openssl rand -base64 48

# Superuser password of the development Postgres (docker-compose.yml).
POSTGRES_PASSWORD=postgres

# Administrative connection: used only for migrations and to set the
# `authenticator` password. The API connects to the same host/database as `authenticator`.
NELCOTA_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
NELCOTA_AUTHENTICATOR_PASSWORD=change-this-authenticator-password
# Ed25519 key (PKCS#8) that signs the JWTs; the public key goes to the JWKS.
# Generate with: nelcota keygen
NELCOTA_JWT_PRIVATE_KEY=
# Legacy alternative: HS256 secret (>= 32 bytes).
NELCOTA_JWT_SECRET=change-this-jwt-secret-with-32-characters-or-more
# `iss` claim of issued tokens.
# NELCOTA_JWT_ISSUER=nelcota
NELCOTA_JWT_EXPIRY_SECS=900
NELCOTA_REFRESH_TOKEN_TTL_DAYS=30
NELCOTA_SIGNUP_ENABLED=true
NELCOTA_AUTH_RATE_LIMIT_PER_MINUTE=30
# REST and storage requests per minute, per account or IP; 0 turns it off.
NELCOTA_API_RATE_LIMIT_PER_MINUTE=600
# Password recovery by email (optional; all three together or none).
# Provider SMTP: smtps://user:password@host:465 or smtp://...:587?tls=required
NELCOTA_SMTP_URL=
# Sender: Shop <no-reply@shop.com>
NELCOTA_SMTP_FROM=
# Page of your app that receives the link (the token goes in #type=recovery&token=...).
NELCOTA_PASSWORD_RECOVERY_URL=
# Optional, with SMTP: signup waits for the email to be confirmed on this page.
NELCOTA_EMAIL_CONFIRMATION_URL=
# Optional, with SMTP: passwordless sign-in links land on this page.
NELCOTA_MAGIC_LINK_URL=
# Sign-in with Google or GitHub (optional): this API's public origin, the app
# pages a sign-in may return to (comma separated) and each provider's client.
NELCOTA_API_URL=
NELCOTA_OAUTH_REDIRECT_URLS=
NELCOTA_OAUTH_GOOGLE_CLIENT_ID=
NELCOTA_OAUTH_GOOGLE_CLIENT_SECRET=
NELCOTA_OAUTH_GITHUB_CLIENT_ID=
NELCOTA_OAUTH_GITHUB_CLIENT_SECRET=
# true only behind a trusted proxy; reads the caller from X-Forwarded-For.
# Restrict direct access to the API and configure proxy/CDN forwarding deliberately.
NELCOTA_TRUST_PROXY=false
# Trusted proxies that append to X-Forwarded-For: 1 for Caddy, 2 for CDN + Caddy.
# NELCOTA_TRUSTED_PROXY_HOPS=1

# This sample chooses loopback; raw serve defaults to 0.0.0.0:8000.
NELCOTA_LISTEN=127.0.0.1:8000
NELCOTA_DB_POOL_SIZE=10
NELCOTA_REQUEST_TIMEOUT_SECS=15
# statement_timeout of the API connections, in seconds.
# NELCOTA_STATEMENT_TIMEOUT_SECS=10
# Schema exposed by the REST API.
# NELCOTA_DB_SCHEMA=public
# Row cap per API collection.
# NELCOTA_MAX_ROWS=1000
# Largest REST request body (writes and RPC arguments), in bytes; default 2 MiB.
# NELCOTA_MAX_BODY_BYTES=2097152
# text | json
NELCOTA_LOG_FORMAT=text
RUST_LOG=info,tower_http=info

# Admin panel (off unless both are set). The hash is a PHC argon2id string;
# `nelcota init` and `nelcota admin-password` generate it on a host. Quote it
# with single quotes: it contains `$`.
# NELCOTA_ADMIN_EMAIL=admin@example.com
# NELCOTA_ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
# Panel single sign-on between the projects of one host (set by `nelcota init`).
# NELCOTA_ADMIN_SSO_SECRET=
# Project name and the host's public project list (set by `nelcota init`).
# NELCOTA_PROJECT_NAME=
# NELCOTA_HOST_REGISTRY=
# Migrations folder the panel writes generated migrations against.
# NELCOTA_MIGRATIONS_DIR=./migrations

# File storage: off | disk | s3.
# NELCOTA_STORAGE_BACKEND=off
# Disk backend directory.
# NELCOTA_STORAGE_DIR=./storage
# S3 backend (endpoint empty = AWS; e.g. https://<account>.r2.cloudflarestorage.com).
# NELCOTA_STORAGE_S3_ENDPOINT=
# NELCOTA_STORAGE_S3_BUCKET=
# NELCOTA_STORAGE_S3_REGION=auto
# NELCOTA_STORAGE_S3_ACCESS_KEY_ID=
# NELCOTA_STORAGE_S3_SECRET_ACCESS_KEY=
# true for bucket.endpoint URLs instead of endpoint/bucket.
# NELCOTA_STORAGE_S3_VIRTUAL_HOSTED=false
# Largest file accepted, in bytes (50 MiB).
# NELCOTA_STORAGE_MAX_FILE_SIZE=52428800
# Cap on the bytes of all buckets together (unset = no cap).
# NELCOTA_STORAGE_MAX_TOTAL_SIZE=
# Disk backend: refuse an upload that would leave less free space (1 GiB).
# NELCOTA_STORAGE_MIN_FREE_BYTES=1073741824
# Origin of public file URLs (unset = this API's own).
# NELCOTA_STORAGE_PUBLIC_URL=https://files.example.com
# Longest an upload may take, in seconds.
# NELCOTA_STORAGE_UPLOAD_TIMEOUT_SECS=3600

# Development only: permit HTTP webhooks to localhost, 127.0.0.1 or ::1.
# Public destinations always require HTTPS; private networks remain blocked.
# NELCOTA_WEBHOOKS_ALLOW_LOOPBACK=false

# Optional TOML file with the same settings (environment variables win).
# NELCOTA_CONFIG=nelcota.toml

# Controller-owned deployment validation fields are documented separately:
# NELCOTA_DEPLOYMENT_VALIDATION, NELCOTA_DEPLOYMENT_GATE, NELCOTA_DEPLOYMENT_ID.
# Do not set them manually or use them to bypass acceptance/maintenance gates.
# Offsite backup settings belong in host.env; see docs/backup.md.
