{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "/dist/index.js": ["../src/index.ts"],
      "@nelcota/client": ["../src/index.ts"],
      "/dist/*": ["../src/*"],
      "/browser-contract.mjs": ["./browser/contract.mjs"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "runtime/*.mjs",
    "browser/*.mjs",
    "browser/*.d.ts",
    "runtime/*.d.ts",
    "unit/**/*.ts",
    "types/**/*.ts"
  ]
}
