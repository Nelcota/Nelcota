{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["scripts/*.ts", "scripts/*.mjs"]
}
