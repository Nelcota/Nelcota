{
  "name": "@nelcota/client",
  "version": "0.2.5",
  "description": "TypeScript client for Nelcota: REST under RLS, auth and storage.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nelcota/Nelcota.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/Nelcota/Nelcota/blob/main/sdk/typescript/README.md",
  "keywords": [
    "nelcota",
    "postgres",
    "rls",
    "rest",
    "auth",
    "storage",
    "baas"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "default": "./dist/rest/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/contract.md",
    "docs/quickstart.pt-BR.md",
    "examples"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun scripts/clean.ts && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "test": "bun --bun vitest run --project unit",
    "test:node": "vitest run --project unit",
    "test:types": "bun --bun vitest run --project types",
    "test:contract": "bun scripts/contract.ts",
    "test:package": "node scripts/package-test.mjs",
    "test:runtime": "bun test/runtime/smoke.mjs",
    "test:runtime:node": "node test/runtime/smoke.mjs",
    "test:memory": "node --expose-gc test/runtime/memory.mjs",
    "example:browser": "bun scripts/example-server.ts",
    "size": "bun scripts/size.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run test && bun run test:types && bun run build && bun run size && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fake-indexeddb": "6.2.6",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
