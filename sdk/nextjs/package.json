{
  "name": "@nelcota/nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Request-scoped Nelcota integration for the Next.js App Router",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/server.js",
    "./dist/postgres.js",
    "./dist/proxy.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/memory-store.d.ts",
      "default": "./dist/memory-store.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "sql",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "@nelcota/client": "^0.2.1",
    "next": "^16.4.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@nelcota/client": "file:../typescript",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.4"
  }
}
