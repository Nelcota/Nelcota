{
  "name": "@nelcota/nextjs",
  "version": "0.1.2",
  "private": false,
  "description": "Request-scoped Nelcota integration for the Next.js App Router",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/server.js",
    "./dist/postgres.js",
    "./dist/proxy.js"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/memory-store.d.ts",
      "default": "./dist/memory-store.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=2",
    "test:bun": "bun --bun vitest run --maxWorkers=2",
    "prepack": "bun run build"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "@nelcota/client": "^0.2.2",
    "@nelcota/ssr": "^0.1.0",
    "next": "^16.4.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@nelcota/client": "file:../typescript",
    "@nelcota/ssr": "file:../ssr",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nelcota/Nelcota.git",
    "directory": "sdk/nextjs"
  },
  "homepage": "https://github.com/Nelcota/Nelcota/tree/main/sdk/nextjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
