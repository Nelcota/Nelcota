{
  "name": "nelcota-admin-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run guides:check && bun --bun vite build",
    "check": "bun run guides:check && bun --bun svelte-check --tsconfig ./tsconfig.app.json && bun node_modules/typescript-7/bin/tsc -p tsconfig.node.json && bun node_modules/typescript-7/bin/tsc -p tsconfig.e2e.json && bun node_modules/typescript-7/bin/tsc -p tsconfig.scripts.json",
    "guides:check": "bun scripts/guides-i18n.ts --check",
    "guides:pending": "bun scripts/guides-i18n.ts --pending",
    "test": "bun --bun vitest run src",
    "test:node": "vitest run src",
    "test:memory": "vitest run src/lib/resources/query-client.test.ts --pool forks --execArgv=--expose-gc",
    "contracts": "cargo run --manifest-path ../../../Cargo.toml -p nelcota-admin --example export_contracts && bun scripts/contracts.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.43",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.7.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@scalar/api-reference": "^1.74.0",
    "@tanstack/svelte-query": "^6.3.5",
    "@tanstack/svelte-table": "^9.3.1",
    "@uppy/core": "^6.3.0",
    "@uppy/xhr-upload": "^6.0.1",
    "codemirror": "^6.0.2",
    "marked": "^18.1.1",
    "shiki": "^4.5.0"
  },
  "overrides": {
    "@ai-sdk/provider-utils@4": "4.0.62",
    "ai@6": "6.0.315",
    "@ai-sdk/vue@3": "3.0.315",
    "@ai-sdk/gateway@3": "3.0.221"
  }
}
